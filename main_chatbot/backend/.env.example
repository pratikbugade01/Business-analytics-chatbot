# Backend-only configuration. Copy this file to .env for local development.
# Never commit the copied .env file and never expose GROQ_API_KEY to the browser.

GROQ_API_KEY=replace-with-your-secret
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_MAX_TOKENS=3500
LLM_TEMPERATURE=0.0
PANDASAI_MAX_RETRIES=1
MAX_UPLOAD_SIZE_MB=25
SESSION_TTL_MINUTES=60
MAX_ACTIVE_SESSIONS=20
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
